  ip                 String                   @db.VarChar(80)
  expiresAt          DateTime                 @map("expires_at")
  verifiedAt         DateTime?                @map("verified_at")
  consumedAt         DateTime?                @map("consumed_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([email, purpose, status, createdAt])
  @@index([userId, createdAt])
  @@map("email_verification_requests")
}

model PasswordResetRequest {
  id         Int                 @id @default(autoincrement())
  userId     Int                 @map("user_id")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  status     PasswordResetStatus @default(pending)
  ip         String              @db.VarChar(80)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@map("password_reset_requests")
}

model MailJob {
  id        Int           @id @default(autoincrement())
  userId    Int?          @map("user_id")
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      MailJobType
  status    MailJobStatus @default(pending)
  recipient String        @db.VarChar(191)
  subject   String        @db.VarChar(255)
  attempts  Int           @default(0)
  lastError String?       @map("last_error") @db.VarChar(1000)
  metadata  Json?
  sentAt    DateTime?     @map("sent_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([recipient, createdAt])
  @@map("mail_jobs")
}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointHash String   @unique @map("endpoint_hash") @db.Char(64)
  endpoint     String   @db.Text
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  userAgent    String   @default("") @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("push_subscriptions")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorId       Int?     @map("actor_id")
  actor         User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorUsername String   @map("actor_username") @db.VarChar(32)
  actorNickname String   @map("actor_nickname") @db.VarChar(32)
  action        String   @db.VarChar(120)
  scope         String   @db.VarChar(24)
  method        String   @db.VarChar(10)
  path          String   @db.VarChar(512)
  targetType    String?  @map("target_type") @db.VarChar(80)
  targetId      String?  @map("target_id") @db.VarChar(120)
  summary       String   @db.VarChar(255)
  metadata      Json?
  ip            String   @default("") @db.VarChar(80)
  userAgent     String   @default("") @map("user_agent") @db.VarChar(500)
  statusCode    Int      @map("status_code")
  durationMs    Int      @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([scope, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
