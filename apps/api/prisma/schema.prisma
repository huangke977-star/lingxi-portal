generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  active
  disabled
}

enum PortalCategoryKind {
  navigation
  tool
  server
  custom_page
}

enum PortalVisibility {
  public
  authenticated
  role_restricted
}

enum PortalRecordStatus {
  active
  disabled
}

enum ArticleStatus {
  draft
  published
  unpublished
  blocked
  deleted
}

enum ArticleVisibility {
  public
  authenticated
  role_restricted
  private
}

enum SiteAssetKind {
  logo
  pwa_icon
}

enum ArticleTaxonomyKind {
  category
  tag
}

enum ArticleCommentStatus {
  active
  blocked
  deleted
}

enum ArticleCommentReportReason {
  spam
  harassment
  illegal
  privacy
  misinformation
  other
}

enum ArticleCommentReportStatus {
  pending
  resolved
  rejected
}

enum FriendshipStatus {
  pending
  accepted
  declined
  removed
  blocked
}

enum UserNotificationType {
  friend_request_received
  friend_request_accepted
  friend_request_declined
  comment_report_resolved
  comment_report_rejected
  comment_author_moderated
  article_liked
  article_favorited
  article_commented
  comment_replied
  author_subscribed
  subscription_published
  system
}

enum UserNotificationChannel {
  system
  subscription
  interaction
}

enum EmailVerificationPurpose {
  registration
  account_email
  device_login
}

enum EmailVerificationStatus {
  pending
  verified
  consumed
  expired
}

enum PasswordResetStatus {
  pending
  consumed
  expired
}

enum MailJobType {
  registration_verification
  account_email_verification
  device_login_verification
  password_reset
  login_risk
  security_notice
}

enum MailJobStatus {
  pending
  sending
  sent
  failed
}

enum LoginSecurityEventType {
  login_success
  new_device
  new_ip
  unusual_frequency
  login_blocked
  password_reset
  password_changed
  email_verified
}

enum LoginRiskLevel {
  info
  low
  medium
  high
}

enum StorageScanStatus {
  running
  completed
  failed
}

enum StorageScanTrigger {
  manual
  scheduled
}

enum StorageIssueKind {
  missing
  orphan
  metadata_mismatch
}

enum MediaBackupJobStatus {
  pending
  running
  completed
  partial
  failed
}

enum MediaBackupJobTrigger {
  manual
  scheduled
}

enum MediaBackupProvider {
  oss
  r2
}

enum MediaBackupManifestStatus {
  pending
  uploaded
  reused
  skipped
  failed
}

enum MediaBackupJobLogLevel {
  info
  warning
  error
}

enum StorageRepairAction {
  remote_restore
  reupload
  confirm_unrecoverable
}

enum StorageRepairStatus {
  running
  completed
  failed
}

enum ChatMessageType {
  text
  attachment
  mixed
  system
}

enum ChatAttachmentKind {
  image
  file
  audio
  video
}

enum CallType {
  voice
  video
}

enum CallStatus {
  ringing
  accepted
  declined
  busy
  cancelled
  missed
  active
  completed
  failed
}

model Role {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique @db.VarChar(64)
  name                String               @db.VarChar(64)
  level               Int                  @unique
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  portalEntryRoles    PortalEntryRole[]
  articleAllowedRoles ArticleAllowedRole[]

  @@map("roles")
}

model User {
  id                        Int                            @id @default(autoincrement())
  username                  String                         @unique @db.VarChar(32)
  nickname                  String                         @db.VarChar(32)
  email                     String                         @unique @db.VarChar(191)
  emailVerifiedAt           DateTime?                      @map("email_verified_at")
  authVersion               Int                            @default(0) @map("auth_version")
  passwordHash              String                         @map("password_hash") @db.VarChar(255)
  roleId                    Int                            @map("role_id")
  role                      Role                           @relation(fields: [roleId], references: [id])
  isSuperAdmin              Boolean                        @default(false) @map("is_super_admin")
  status                    UserStatus                     @default(active)
  appearanceThemeId         String                         @default("cloud-blue") @map("appearance_theme_id") @db.VarChar(64)
  customAccent              String                         @default("#1814f0") @map("custom_accent") @db.VarChar(7)
  customSurface             String                         @default("#dfc8c8") @map("custom_surface") @db.VarChar(7)
  customForeground          String                         @default("#2b2530") @map("custom_foreground") @db.VarChar(7)
  customMuted               String                         @default("#665867") @map("custom_muted") @db.VarChar(7)
  cardAlpha                 Int                            @default(50) @map("card_alpha")
  glassBlur                 Int                            @default(18) @map("glass_blur")
  glassTint                 String                         @default("#fff3f6") @map("glass_tint") @db.VarChar(7)
  glassTintAlpha            Int                            @default(0) @map("glass_tint_alpha")
  appearanceCustomized      Boolean                        @default(false) @map("appearance_customized")
  avatarOriginalName        String?                        @map("avatar_original_name") @db.VarChar(255)
  avatarStoredName          String?                        @unique @map("avatar_stored_name") @db.VarChar(255)
  avatarMimeType            String?                        @map("avatar_mime_type") @db.VarChar(64)
  avatarSizeBytes           Int?                           @map("avatar_size_bytes")
  profileBio                String                         @default("我懒，我不写") @map("profile_bio") @db.VarChar(180)
  lastLoginAt               DateTime?                      @map("last_login_at")
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")
  backgroundImages          BackgroundImage[]
  siteAssets                SiteAsset[]
  androidReleases           AndroidRelease[]
  portalCategoriesCreated   PortalCategory[]               @relation("PortalCategoryCreatedBy")
  portalCategoriesUpdated   PortalCategory[]               @relation("PortalCategoryUpdatedBy")
  portalEntriesCreated      PortalEntry[]                  @relation("PortalEntryCreatedBy")
  portalEntriesUpdated      PortalEntry[]                  @relation("PortalEntryUpdatedBy")
  articles                  Article[]                      @relation("ArticleAuthor")
  articleComments           ArticleComment[]               @relation("ArticleCommentAuthor")
  articleLikes              ArticleLike[]
  articleFavorites          ArticleFavorite[]
  articleViews              ArticleView[]
  articleReadLater          ArticleReadLater[]
  articleReadingHistory     ArticleReadingHistory[]
  articleCommentLikes       ArticleCommentLike[]
  articleCommentReports     ArticleCommentReport[]         @relation("ArticleCommentReporter")
  handledCommentReports     ArticleCommentReport[]         @relation("ArticleCommentReportHandler")
  friendshipsAsOne          Friendship[]                   @relation("FriendshipUserOne")
  friendshipsAsTwo          Friendship[]                   @relation("FriendshipUserTwo")
  friendshipRequests        Friendship[]                   @relation("FriendshipRequester")
  blockedFriendships        Friendship[]                   @relation("FriendshipBlocker")
  chatMessages              ChatMessage[]                  @relation("ChatMessageSender")
  conversationStates        ConversationParticipantState[]
  hiddenChatMessages        ChatMessageDeletion[]
  chatAttachments           ChatAttachment[]               @relation("ChatAttachmentUploader")
  callsStarted              CallSession[]                  @relation("CallSessionCaller")
  callsReceived             CallSession[]                  @relation("CallSessionCallee")
  callsEnded                CallSession[]                  @relation("CallSessionEndedBy")
  notifications             UserNotification[]             @relation("UserNotificationRecipient")
  notificationActions       UserNotification[]             @relation("UserNotificationActor")
  notificationChannelStates UserNotificationChannelState[]
  subscriptionsGiven        UserSubscription[]             @relation("UserSubscriptionSubscriber")
  subscriptionsReceived     UserSubscription[]             @relation("UserSubscriptionAuthor")
  auditLogs                 AuditLog[]                     @relation("AuditLogActor")
  pushSubscriptions         PushSubscription[]
  securityPreference        UserSecurityPreference?
  knownLoginDevices         KnownLoginDevice[]
  loginSecurityEvents       LoginSecurityEvent[]
  emailVerificationRequests EmailVerificationRequest[]
  passwordResetRequests     PasswordResetRequest[]
  mailJobs                  MailJob[]

  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

model BackgroundImage {
  id           Int      @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(64)
  sizeBytes    Int      @map("size_bytes")
  isActive     Boolean  @default(false) @map("is_active")
  uploadedById Int      @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([uploadedById])
  @@map("background_images")
}

model SiteAsset {
  id           Int           @id @default(autoincrement())
  kind         SiteAssetKind
  originalName String        @map("original_name") @db.VarChar(255)
  storedName   String        @unique @map("stored_name") @db.VarChar(255)
  mimeType     String        @map("mime_type") @db.VarChar(80)
  sizeBytes    Int           @map("size_bytes")
  uploadedById Int           @map("uploaded_by_id")
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([kind, createdAt])
  @@index([uploadedById])
  @@map("site_assets")
}

model AndroidRelease {
  id           Int      @id @default(autoincrement())
  versionName  String   @map("version_name") @db.VarChar(40)
  versionCode  Int      @map("version_code")
  channel      String   @default("stable") @db.VarChar(40)
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(80)
  sizeBytes    Int      @map("size_bytes")
  sha256       String   @db.Char(64)
  releaseNotes String   @default("") @map("release_notes") @db.Text
  isActive     Boolean  @default(false) @map("is_active")
  uploadedById Int      @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, updatedAt])
  @@index([versionCode])
  @@index([uploadedById])
  @@map("android_releases")
}

model SiteSetting {
  id                             Int               @id @default(1)
  siteName                       String            @default("HLOVET") @map("site_name") @db.VarChar(80)
  browserTitle                   String            @default("HLOVET") @map("browser_title") @db.VarChar(120)
  logoPath                       String            @default("/favicon.svg") @map("logo_path") @db.VarChar(512)
  pwaIconPath                    String            @default("/icon-192.png") @map("pwa_icon_path") @db.VarChar(512)
  defaultBackgroundUrl           String            @default("/images/hlovet-cloud-blue.jpeg") @map("default_background_url") @db.VarChar(512)
  defaultThemeId                 String            @default("cloud-blue") @map("default_theme_id") @db.VarChar(64)
  defaultAccent                  String            @default("#1814f0") @map("default_accent") @db.VarChar(7)
  defaultSurface                 String            @default("#dfc8c8") @map("default_surface") @db.VarChar(7)
  defaultForeground              String            @default("#2b2530") @map("default_foreground") @db.VarChar(7)
  defaultMuted                   String            @default("#665867") @map("default_muted") @db.VarChar(7)
  defaultCardAlpha               Int               @default(50) @map("default_card_alpha")
  defaultGlassBlur               Int               @default(18) @map("default_glass_blur")
  defaultGlassTint               String            @default("#fff3f6") @map("default_glass_tint") @db.VarChar(7)
  defaultGlassTintAlpha          Int               @default(0) @map("default_glass_tint_alpha")
  registrationOpen               Boolean           @default(true) @map("registration_open")
  defaultRoleCode                String            @default("qi_refining") @map("default_role_code") @db.VarChar(64)
  installPageEnabled             Boolean           @default(true) @map("install_page_enabled")
  apkHistoryEnabled              Boolean           @default(true) @map("apk_history_enabled")
  apkAutoCleanupEnabled          Boolean           @default(false) @map("apk_auto_cleanup_enabled")
  apkRetentionCount              Int               @default(3) @map("apk_retention_count")
  defaultArticleVisibility       ArticleVisibility @default(public) @map("default_article_visibility")
  articleImageMaxSizeMb          Int               @default(10) @map("article_image_max_size_mb")
  commentsEnabled                Boolean           @default(true) @map("comments_enabled")
  reportsEnabled                 Boolean           @default(true) @map("reports_enabled")
  notifyArticleLiked             Boolean           @default(true) @map("notify_article_liked")
  notifyArticleFavorited         Boolean           @default(true) @map("notify_article_favorited")
  notifyArticleCommented         Boolean           @default(true) @map("notify_article_commented")
  notifyCommentReplied           Boolean           @default(true) @map("notify_comment_replied")
  notifyAuthorSubscribed         Boolean           @default(true) @map("notify_author_subscribed")
  notifySubscriptionPublished    Boolean           @default(true) @map("notify_subscription_published")
  notifyFriendRequest            Boolean           @default(true) @map("notify_friend_request")
  notifyCommentReport            Boolean           @default(true) @map("notify_comment_report")
  notifySystem                   Boolean           @default(true) @map("notify_system")
  templateArticleLiked           String            @default("{actor} 点赞了《{article}》。") @map("template_article_liked") @db.VarChar(240)
  templateArticleFavorited       String            @default("{actor} 收藏了《{article}》。") @map("template_article_favorited") @db.VarChar(240)
  templateArticleCommented       String            @default("{actor} 评论了《{article}》。") @map("template_article_commented") @db.VarChar(240)
  templateCommentReplied         String            @default("{actor} 回复了你在《{article}》中的评论。") @map("template_comment_replied") @db.VarChar(240)
  templateAuthorSubscribed       String            @default("{actor} 订阅了你。") @map("template_author_subscribed") @db.VarChar(240)
  templateSubscriptionPublished  String            @default("{author} 发布了《{article}》。") @map("template_subscription_published") @db.VarChar(240)
  templateFriendRequest          String            @default("{actor} 向你发送了好友申请。") @map("template_friend_request") @db.VarChar(240)
  templateCommentReportHandled   String            @default("你对《{article}》中评论的举报已{result}。") @map("template_comment_report_handled") @db.VarChar(240)
  templateCommentAuthorModerated String            @default("你在《{article}》中的评论已被{result}。") @map("template_comment_author_moderated") @db.VarChar(240)
  createdAt                      DateTime          @default(now()) @map("created_at")
  updatedAt                      DateTime          @updatedAt @map("updated_at")

  @@map("site_settings")
}

model BackupConfiguration {
  id                          Int       @id @default(1)
  automaticEnabled            Boolean   @default(false) @map("automatic_enabled")
  scheduleTime                String    @default("03:00") @map("schedule_time") @db.Char(5)
  timezone                    String    @default("Asia/Shanghai") @db.VarChar(64)
  localRetentionDays          Int       @default(7) @map("local_retention_days")
  remoteRetentionDays         Int       @default(90) @map("remote_retention_days")
  ossEnabled                  Boolean   @default(false) @map("oss_enabled")
  ossRegion                   String?   @map("oss_region") @db.VarChar(80)
  ossEndpoint                 String?   @map("oss_endpoint") @db.VarChar(255)
  ossBucket                   String?   @map("oss_bucket") @db.VarChar(128)
  ossPrefix                   String    @default("database") @map("oss_prefix") @db.VarChar(255)
  ossAccessKeyIdEncrypted     String?   @map("oss_access_key_id_encrypted") @db.Text
  ossAccessKeySecretEncrypted String?   @map("oss_access_key_secret_encrypted") @db.Text
  r2Enabled                   Boolean   @default(false) @map("r2_enabled")
  r2AccountId                 String?   @map("r2_account_id") @db.VarChar(64)
  r2Bucket                    String?   @map("r2_bucket") @db.VarChar(128)
  r2Prefix                    String    @default("database") @map("r2_prefix") @db.VarChar(255)
  r2AccessKeyIdEncrypted      String?   @map("r2_access_key_id_encrypted") @db.Text
  r2SecretAccessKeyEncrypted  String?   @map("r2_secret_access_key_encrypted") @db.Text
  lastAutomaticBackupDate     String?   @map("last_automatic_backup_date") @db.Char(10)
  lastMediaBackupDate         String?   @map("last_media_backup_date") @db.Char(10)
  lastSuccessAt               DateTime? @map("last_success_at")
  lastFailureAt               DateTime? @map("last_failure_at")
  lastFailureMessage          String?   @map("last_failure_message") @db.VarChar(500)
  lastBackupName              String?   @map("last_backup_name") @db.VarChar(255)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("backup_configurations")
}

model StorageManagementConfiguration {
  id                      Int       @id @default(1)
  automaticScanEnabled    Boolean   @default(true) @map("automatic_scan_enabled")
  scanTime                String    @default("04:00") @map("scan_time") @db.Char(5)
  timezone                String    @default("Asia/Shanghai") @db.VarChar(64)
  trashRetentionDays      Int       @default(7) @map("trash_retention_days")
  warningThresholdPercent Int       @default(75) @map("warning_threshold_percent")
  lastScheduledScanDate   String?   @map("last_scheduled_scan_date") @db.Char(10)
  lastScanAt              DateTime? @map("last_scan_at")
  lastWarningAt           DateTime? @map("last_warning_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("storage_management_configurations")
}

model StorageScan {
  id            Int                @id @default(autoincrement())
  status        StorageScanStatus  @default(running)
  trigger       StorageScanTrigger
  triggeredById Int?               @map("triggered_by_id")
  summary       Json?
  error         String?            @db.VarChar(500)
  startedAt     DateTime           @default(now()) @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  issues        StorageScanIssue[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("storage_scans")
}

model StorageScanIssue {
  id                Int                 @id @default(autoincrement())
  scanId            Int                 @map("scan_id")
  scan              StorageScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  kind              StorageIssueKind
  category          String              @db.VarChar(40)
  storedName        String              @map("stored_name") @db.VarChar(512)
  mimeType          String?             @map("mime_type") @db.VarChar(127)
  expectedSizeBytes Int?                @map("expected_size_bytes")
  actualSizeBytes   Int?                @map("actual_size_bytes")
  sourceType        String              @map("source_type") @db.VarChar(64)
  sourceId          String?             @map("source_id") @db.VarChar(80)
  sourceLabel       String              @map("source_label") @db.VarChar(255)
  sourceUrl         String?             @map("source_url") @db.VarChar(512)
  uploadedBy        String?             @map("uploaded_by") @db.VarChar(80)
  fileUpdatedAt     DateTime?           @map("file_updated_at")
  resolvedAt        DateTime?           @map("resolved_at")
  resolution        String?             @db.VarChar(40)
  createdAt         DateTime            @default(now()) @map("created_at")
  repairs           StorageFileRepair[]

  @@index([scanId, resolvedAt, kind, category])
  @@index([category, storedName])
  @@map("storage_scan_issues")
}

model StorageTrashItem {
  id                 Int      @id @default(autoincrement())
  category           String   @db.VarChar(40)
  originalStoredName String   @map("original_stored_name") @db.VarChar(512)
  trashStoredName    String   @unique @map("trash_stored_name") @db.VarChar(255)
  mimeType           String?  @map("mime_type") @db.VarChar(127)
  sizeBytes          Int      @map("size_bytes")
  trashedById        Int?     @map("trashed_by_id")
  deletedAt          DateTime @default(now()) @map("deleted_at")
  purgeAfter         DateTime @map("purge_after")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([purgeAfter])
  @@index([category, deletedAt])
  @@map("storage_trash_items")
}

model MediaBackupJob {
  id             Int                   @id @default(autoincrement())
  status         MediaBackupJobStatus  @default(pending)
  trigger        MediaBackupJobTrigger
  triggeredById  Int?                  @map("triggered_by_id")
  providers      Json
  totalFiles     Int                   @default(0) @map("total_files")
  processedFiles Int                   @default(0) @map("processed_files")
  uploadedFiles  Int                   @default(0) @map("uploaded_files")
  reusedFiles    Int                   @default(0) @map("reused_files")
  skippedFiles   Int                   @default(0) @map("skipped_files")
  failedFiles    Int                   @default(0) @map("failed_files")
  totalBytes     BigInt                @default(0) @map("total_bytes")
  uploadedBytes  BigInt                @default(0) @map("uploaded_bytes")
  error          String?               @db.VarChar(500)
  startedAt      DateTime?             @map("started_at")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  manifests      MediaBackupManifest[]
  logs           MediaBackupJobLog[]

  @@index([status, createdAt])
  @@index([trigger, createdAt])
  @@map("media_backup_jobs")
}

model MediaBackupFile {
  id             Int                   @id @default(autoincrement())
  category       String                @db.VarChar(40)
  storedName     String                @map("stored_name") @db.VarChar(512)
  mimeType       String?               @map("mime_type") @db.VarChar(127)
  sourceType     String                @map("source_type") @db.VarChar(64)
  sourceId       String?               @map("source_id") @db.VarChar(80)
  sourceLabel    String                @map("source_label") @db.VarChar(255)
  sourceUrl      String?               @map("source_url") @db.VarChar(512)
  uploadedBy     String?               @map("uploaded_by") @db.VarChar(80)
  sizeBytes      Int                   @map("size_bytes")
  contentHash    String?               @map("content_hash") @db.Char(64)
  fileUpdatedAt  DateTime?             @map("file_updated_at")
  lastSeenAt     DateTime              @default(now()) @map("last_seen_at")
  lastBackedUpAt DateTime?             @map("last_backed_up_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  manifests      MediaBackupManifest[]

  @@unique([category, storedName])
  @@index([contentHash, sizeBytes])
  @@index([lastSeenAt])
  @@map("media_backup_files")
}

model MediaBackupManifest {
  id            Int                       @id @default(autoincrement())
  jobId         Int                       @map("job_id")
  job           MediaBackupJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileId        Int                       @map("file_id")
  file          MediaBackupFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  provider      MediaBackupProvider
  status        MediaBackupManifestStatus @default(pending)
  contentHash   String                    @map("content_hash") @db.Char(64)
  sizeBytes     Int                       @map("size_bytes")
  fileUpdatedAt DateTime?                 @map("file_updated_at")
  bucket        String?                   @db.VarChar(128)
  objectKey     String?                   @map("object_key") @db.VarChar(512)
  etag          String?                   @db.VarChar(255)
  error         String?                   @db.VarChar(500)
  attemptCount  Int                       @default(0) @map("attempt_count")
  lastAttemptAt DateTime?                 @map("last_attempt_at")
  startedAt     DateTime?                 @map("started_at")
  completedAt   DateTime?                 @map("completed_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  @@unique([jobId, fileId, provider])
  @@index([jobId, status], map: "media_backup_manifest_job_status_idx")
  @@index([fileId, provider, contentHash, status], map: "media_backup_manifest_lookup_idx")
  @@index([provider, contentHash, sizeBytes, status], map: "media_backup_manifest_content_idx")
  @@map("media_backup_manifests")
}

model MediaBackupJobLog {
  id        Int                    @id @default(autoincrement())
  jobId     Int                    @map("job_id")
  job       MediaBackupJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     MediaBackupJobLogLevel @default(info)
  event     String                 @db.VarChar(64)
  message   String                 @db.VarChar(500)
  fileId    Int?                   @map("file_id")
  provider  MediaBackupProvider?
  attempt   Int?
