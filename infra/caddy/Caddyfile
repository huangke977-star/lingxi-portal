{$SITE_DOMAIN:5200918.xyz} {
  encode zstd gzip

  handle /socket.io/* {
    reverse_proxy api:3001
  }

  handle_path /api/* {
    reverse_proxy api:3001
  }

  handle /_next/static/* {
    reverse_proxy web:3000 {
      header_down Cache-Control "public, max-age=0, must-revalidate"
    }
  }

  handle {
    # HTML must be revalidated after each deployment; only fingerprinted Next assets are cacheable.
    reverse_proxy web:3000 {
      header_down Cache-Control "no-store, max-age=0, must-revalidate"
    }
  }
}
